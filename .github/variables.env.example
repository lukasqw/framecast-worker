# ============================================================
# framecast-worker — GitHub Actions Variables
# ============================================================
# Configure em: Settings → Secrets and Variables → Actions → Variables
# Estas são variáveis públicas (vars.*). Credenciais sensíveis
# devem ir em Secrets (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, etc.).
# ============================================================

# AWS
AWS_REGION=us-east-1

# Go
GO_VERSION=1.25

# GHCR — image name is derived automatically from the repository (ghcr.io/<owner>/<repo>).
# No variable needed. GHCR_PAT (classic PAT, scope write:packages) must be set as a Secret.

# EKS
EKS_CLUSTER=framecast
K8S_NAMESPACE=framecast
K8S_NAMESPACE_DEV=framecast-dev

# Terraform state (lido via AWS CLI no k8s-configure — não requer binário terraform)
TF_STATE_BUCKET=fiap-soat-tf-backend-framecast

# Worker tuning
WORKER_CONCURRENCY=3
FFMPEG_TIMEOUT_MINUTES=10
FFMPEG_FPS=1

# Notificação por e-mail
EMAIL_NOTIFICATIONS_ENABLED=true # false desliga o envio sem mudar o backend configurado
NOTIFIER_BACKEND=smtp            # smtp (padrão) ou ses
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=                   # credencial Mailtrap — vazio = modo dev (imprime no stdout)
SMTP_FROM=noreply@framecast.local
# SMTP_PASSWORD é Secret, não Variable.

# Coverage gate (CI)
COVERAGE_GATE=85

# Health check
HEALTH_ENDPOINT=/health

# Release flow
BASE_BRANCH=main
SOURCE_BRANCH=develop
