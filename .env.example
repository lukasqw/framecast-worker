# Banco de dados
DATABASE_URL=postgres://framecast:framecast@localhost:5432/framecast_db?sslmode=disable

# AWS (LocalStack em dev)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3
S3_BUCKET_RAW=framecast-videos-raw
S3_BUCKET_OUTPUT=framecast-videos-output

# SQS
SQS_QUEUE_URL=http://localhost:4566/000000000000/framecast-processing

# Notifier backend: "smtp" (padrão) ou "ses" (requer SES habilitado — não funciona no Academy)
NOTIFIER_BACKEND=smtp

# SMTP — usado quando NOTIFIER_BACKEND=smtp
# Dev: sem SMTP_USERNAME/SMTP_PASSWORD imprime no stdout (sem I/O)
# Mailtrap sandbox: sandbox.smtp.mailtrap.io:2525
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=          # credencial Mailtrap (Settings → SMTP/POP3 → Username)
SMTP_PASSWORD=          # credencial Mailtrap (Settings → SMTP/POP3 → Password)
SMTP_FROM=noreply@framecast.local

# SES — usado quando NOTIFIER_BACKEND=ses
# Requer identidade verificada no SES. Desabilitado na AWS Academy (LabRole bloqueia ses:VerifyEmailIdentity).
SES_FROM_EMAIL=
SES_RECIPIENT_OVERRIDE= # dev/staging: redireciona todos os e-mails para este endereço

# Worker
WORKER_CONCURRENCY=1
FFMPEG_TIMEOUT_MINUTES=30

# Observabilidade (vazio = OTel desabilitado em dev)
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_ENV=dev
APP_VERSION=local
DD_SERVICE=framecast-worker
